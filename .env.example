# Copy to .env (never commit .env).

# Postgres, local only
PG_HOST=localhost
PG_PORT=5432
PG_DB=olist
PG_USER=olist
PG_PASSWORD=olist

# Airflow runs as your WSL user so it can write to ./data. Get it with: id -u
AIRFLOW_UID=1000

# Slack Incoming Webhook URL. Leave empty and alerts only go to the Airflow task log.
SLACK_WEBHOOK_URL=

# Which Airflow DAG is scheduled: batch (olist_batch_pipeline) or cdc (olist_cdc_pipeline).
# `make airflow-up` and `make cdc-up` set it for you.
INGESTION_MODE=batch
